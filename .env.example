# LangGraph 启动所需配置
OPENAI_API_KEY=
BASE_LLM=
# Additional operator-selectable model IDs on the same configured provider, separated by commas.
# CLOUDPIVOT_PLATFORM_LLMS=
MODEL_API_BASE_URL=
HOST_IP=127.0.0.1
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=agent-files

# 可选的工作区父目录。默认 /agent_files，建议部署时使用持久化目录
AGENT_WORKSPACE_ROOT=
# Optional parent directory of the legacy workspaces that operators can import.
CLOUDPIVOT_LEGACY_WORKSPACE_ROOT=

# 可选的模型配置，留空时相应工具会提示缺失项
BASE_VLM=
# CLOUDPIVOT_PLATFORM_VLMS=
IMAGE_MODEL=
EDIT_IMAGE_MODEL=

# 可选功能。启用 Excel 前须安装 uv，并让 uvx 可通过 PATH 找到
USE_EXCEL=false
TAVILY_SEARCH_KEY=

# FastAPI 邀请注册、账号会话和聊天。使用 CloudPivot 专用数据库。
# URL 可用 postgresql://...，也可填写主机:端口并分别提供库名、用户和密码。
CLOUDPIVOT_DATABASE_URL=
# CLOUDPIVOT_DATABASE_NAME=cloudpivot
# CLOUDPIVOT_DATABASE_USER=
# CLOUDPIVOT_DATABASE_PASSWORD=

# 可选缓存。主机:端口会自动使用 DB 1，完整 URL 建议显式以 /1 结尾。
CLOUDPIVOT_REDIS_URL=
# CLOUDPIVOT_REDIS_PASSWORD=

# HTTPS 默认为 true。本机 HTTP 联调时设为 false。
CLOUDPIVOT_COOKIE_SECURE=true
CLOUDPIVOT_CORS_ORIGINS=
